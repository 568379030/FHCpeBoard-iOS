<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许访问局域网 CPE 的 http:// 明文接口（Android 9+ 默认禁止明文） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
